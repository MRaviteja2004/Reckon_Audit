# Generate with: usso -ussh genai-api -print
USSO_TOKEN=your_usso_token_here

# Optional Uber AI Gateway base URL override (default shown).
# GENAI_BASE_URL=https://genai-api.uberinternal.com/v1

# Optional model overrides (defaults shown).
# EXTRACTION_MODEL and CROSSCHECK_MODEL must be vision-capable — Stage 2 and Stage 4
# send frames as images. Some gateway models accept only their default temperature,
# which the code handles by never sending an explicit value.
# OPENAI_MODEL=claude-opus-5-5
# EXTRACTION_MODEL=claude-opus-5-5
# CROSSCHECK_MODEL=claude-opus-5-5
# ALIGN_ASSIST_MODEL=claude-opus-5-5


# Where saved recordings (video, stage artifacts, Stage 3/4 history) are stored.
# RECKON_RECORDINGS_DIR=recordings
# keep: store the uploaded video in its recording folder.
# discard: keep only its SHA-256 and size, plus decoded evidence stills; Stage 2 retry
# and Stage 4 are then refused in the app (Stage 4 cannot use the stills). Stored
# videos are never deleted.
# RECKON_VIDEO_RETENTION=keep
# full: persist Stage 3/4 prompt text and model responses; hashes: persist hashes only.
# Images are always stored as hashes; credential values are redacted in both modes.
# hashes covers model_calls only — evaluation results and stage-2c.json are always saved.
# RECKON_CAPTURE_MODEL_IO=full
# A "running" evaluation older than this is shown as interrupted (default 6 hours).
# RECKON_STALE_RUN_SECONDS=21600
