# Generate with: usso -ussh genai-api -print
USSO_TOKEN=your_usso_token_here

# Optional model overrides (defaults shown).
# EXTRACTION_MODEL and CROSSCHECK_MODEL must be vision-capable — Stage 2 sends frames
# as images. The GPT-5 family accepts only its default temperature, which the code
# handles by never sending an explicit value.
# OPENAI_MODEL=gpt-5.5
# EXTRACTION_MODEL=gpt-5.5
# CROSSCHECK_MODEL=gpt-5.5
